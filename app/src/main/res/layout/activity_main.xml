<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="#14532d" android:padding="4dp">
        <Button android:id="@+id/back" style="?android:attr/buttonBarButtonStyle" android:layout_width="@dimen/bar_btn" android:layout_height="@dimen/bar_btn" android:minWidth="0dp" android:padding="0dp" android:text="◀" android:textColor="#ffffff" android:textSize="@dimen/bar_icon_text" />
        <Button android:id="@+id/reload" style="?android:attr/buttonBarButtonStyle" android:layout_width="@dimen/bar_btn" android:layout_height="@dimen/bar_btn" android:minWidth="0dp" android:padding="0dp" android:text="⟳" android:textColor="#ffffff" android:textSize="@dimen/bar_icon_text" />
        <Button android:id="@+id/home" style="?android:attr/buttonBarButtonStyle" android:layout_width="@dimen/bar_btn" android:layout_height="@dimen/bar_btn" android:minWidth="0dp" android:padding="0dp" android:text="⌂" android:textColor="#ffffff" android:textSize="@dimen/bar_icon_text" />
        <EditText android:id="@+id/url" android:layout_width="0dp" android:layout_height="@dimen/bar_btn" android:layout_weight="1"
            android:background="#ffffff" android:hint="Address" android:imeOptions="actionGo" android:inputType="textUri"
            android:maxLines="1" android:paddingStart="8dp" android:paddingEnd="8dp" android:textSize="@dimen/bar_text" />
        <Button android:id="@+id/desktop" style="?android:attr/buttonBarButtonStyle" android:layout_width="@dimen/bar_btn_wide" android:layout_height="@dimen/bar_btn" android:minWidth="0dp" android:padding="0dp" android:text="PC" android:textColor="#ffffff" android:textSize="@dimen/bar_icon_text" />
    </LinearLayout>
    <org.mozilla.geckoview.GeckoView android:id="@+id/gecko" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
