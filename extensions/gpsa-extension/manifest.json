{
 "manifest_version": 3,
 "name": "GPSA GIMIS Token Helper",
 "version": "2.25.0",
 "description": "Hifadhi token + chassis kisha ziissue kwa wingi ndani ya GIMIS. Cloud backup (Supabase) + local backup + elapsAI: msaidizi wa AI anayesoma data ya GIMIS na kutengeneza Excel, Word, PDF, chati na picha.",
 "web_accessible_resources": [
  {
   "resources": [
    "bg.jpg",
    "elapsai-logo.png",
    "logo_recolored.png",
    "ai-sandbox.html",
    "ai-sandbox.js",
    "ai-files.js",
    "logo-icon.png",
    "logo-bin.png"
   ],
   "matches": [
    "https://gimis.gpsa.go.tz/*"
   ]
  }
 ],
 "permissions": [
  "storage",
  "unlimitedStorage"
 ],
 "host_permissions": [
  "https://*.supabase.co/*",
  "https://generativelanguage.googleapis.com/*",
  "https://api.groq.com/*",
  "https://openrouter.ai/*",
  "https://api.mistral.ai/*",
  "https://api.ipify.org/*",
  "https://gimis.gpsa.go.tz/*"
 ],
 "background": {
  "service_worker": "background.js"
 },
 "content_scripts": [
  {
   "matches": [
    "https://gimis.gpsa.go.tz/*"
   ],
   "js": [
    "ai-engine.js",
    "injected.js"
   ],
   "run_at": "document_start",
   "world": "MAIN"
  },
  {
   "matches": [
    "https://gimis.gpsa.go.tz/*"
   ],
   "js": [
    "config.js",
    "access.js",
    "content.js",
    "ai-files.js",
    "ai-engine.js",
    "gimis-api-catalog.js",
    "ai-tools.js",
    "ai-core.js",
    "ai.js",
    "xlsx-lite.js",
    "xlsx-export.js",
    "ws-vehicle.js",
    "ws-fuel.js",
    "ws-bincard.js",
    "workspaces.js"
   ],
   "run_at": "document_idle",
   "css": [
    "ws-vehicle.css",
    "ws-fuel.css",
    "ws-bincard.css",
    "workspaces.css"
   ]
  }
 ],
 "icons": {
  "16": "icon16.png",
  "32": "icon32.png",
  "48": "icon48.png",
  "128": "icon128.png"
 },
 "sandbox": {
  "pages": [
   "ai-sandbox.html"
  ]
 },
 "content_security_policy": {
  "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'none'; img-src data: blob:; media-src 'none'; object-src 'none'; frame-src 'none'; style-src 'unsafe-inline'; form-action 'none'"
 },
 "action": {
  "default_title": "GPSA Control (devices, owner, updates)"
 }
}
